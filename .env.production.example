# PostgreSQL do próprio deploy
POSTGRES_DB=cortes
POSTGRES_USER=cortes_app
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Endereços públicos
PUBLIC_WEB_URL=https://app.exemplo.com.br
PUBLIC_API_URL=https://api.exemplo.com.br
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br

# Conta root inicial, criada uma vez quando o banco ainda não tem root
APP_BOOTSTRAP_USER_ID=b3ac24d4-ca96-4be1-aef0-a9775fc4a7e3
APP_BOOTSTRAP_EMAIL=admin@exemplo.com
APP_BOOTSTRAP_NAME=Administrador
APP_BOOTSTRAP_PASSWORD=configure-uma-senha-forte-com-12-caracteres

# Segredo HMAC de pelo menos 32 bytes; gere com: openssl rand -base64 32
APP_JWT_SECRET=gere-um-segredo-privado-de-pelo-menos-32-bytes
APP_PUBLIC_REGISTRATION=true
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Chave de criptografia dos dados do negócio; gere com: openssl rand -base64 32
APP_DATA_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
